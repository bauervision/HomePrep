{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "content_version": {
      "const": "1.0.0"
    },
    "packaged_on": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "properties": {
        "purpose": {
          "const": "read_only_library_display"
        },
        "default_collection": {
          "const": "authoritative_core"
        },
        "book_reviews_separate": {
          "const": true
        },
        "household_mutations_allowed": {
          "const": false
        },
        "automatic_execution_allowed": {
          "const": false
        },
        "readiness_credit": {
          "const": "none"
        },
        "unknown_status_behavior": {
          "const": "exclude_from_guidance_and_show_unavailable_review_status"
        },
        "deduplication": {
          "const": "Core is curated; preserve distinct book records and their provenance. Duplicate-group labels are not proof of equivalent instructions."
        }
      },
      "required": [
        "purpose",
        "default_collection",
        "book_reviews_separate",
        "household_mutations_allowed",
        "automatic_execution_allowed",
        "readiness_credit",
        "unknown_status_behavior",
        "deduplication"
      ],
      "additionalProperties": false
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "source_prefixes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "label",
          "source_prefixes",
          "aliases"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "origin": {
            "enum": [
              "book_review",
              "authoritative_core"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "source_item_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "classification": {
            "enum": [
              null,
              "verified_guidance",
              "source_derived_reference",
              "needs_review"
            ]
          },
          "display_status": {
            "enum": [
              "verified_principle",
              "source_reference",
              "needs_review",
              "authority_supported"
            ]
          },
          "reviewed_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "topic_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source_topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "search_terms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "source_citations": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "relationship": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "evidence_id",
                "url",
                "relationship",
                "scope"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "correction_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "milestone_mapping": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 0
          },
          "safety_flags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "execution_eligible": {
            "const": false
          },
          "automatic_execution_allowed": {
            "const": false
          },
          "readiness_credit": {
            "const": "none"
          },
          "source_record": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "origin",
          "source_id",
          "source_item_id",
          "title",
          "summary",
          "classification",
          "display_status",
          "reviewed_on",
          "topic_ids",
          "source_topics",
          "search_terms",
          "source_citations",
          "evidence",
          "correction_ids",
          "milestone_mapping",
          "safety_flags",
          "execution_eligible",
          "automatic_execution_allowed",
          "readiness_credit",
          "source_record"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "origin": {
                  "const": "book_review"
                }
              }
            },
            "then": {
              "properties": {
                "classification": {
                  "enum": [
                    "verified_guidance",
                    "source_derived_reference",
                    "needs_review"
                  ]
                },
                "source_citations": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "minItems": 1
                },
                "source_record": {
                  "type": "object",
                  "required": [
                    "id",
                    "classification",
                    "verification",
                    "source_citations",
                    "original_claim",
                    "reviewed_guidance",
                    "safety_flags",
                    "execution_eligible"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "classification": {
                  "type": "null"
                },
                "display_status": {
                  "const": "authority_supported"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "evidence_id": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^https://"
                      },
                      "relationship": {
                        "type": "string"
                      },
                      "scope": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "evidence_id",
                      "url",
                      "relationship",
                      "scope"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "source_record": {
                  "type": "object",
                  "required": [
                    "id",
                    "steps",
                    "limits",
                    "completion",
                    "evidence",
                    "prerequisites",
                    "maintenance",
                    "escalation",
                    "editorial_adaptation"
                  ]
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "totals": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "content_version",
    "packaged_on",
    "policy",
    "topics",
    "sources",
    "evidence",
    "corrections",
    "entries",
    "totals"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:homeprep:app-library:1.0.0",
  "title": "HomePrep Library display bundle schema 1.0.0"
}
