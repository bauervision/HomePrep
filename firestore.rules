rules_version = '2';

// HomePrep — household-scoped access.
// A user can only read or write a household they are a member of. Membership is
// created either by founding a new household or by redeeming a single-use,
// expiring invite issued by an existing member.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }

    function memberPath(hid, uid) {
      return /databases/$(database)/documents/households/$(hid)/members/$(uid);
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    function isMember(hid) {
      return signedIn() && exists(memberPath(hid, request.auth.uid));
    }

    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // Pointer from a user to their household; used to locate it after sign-in.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId', 'updatedAt'])
        && existsAfter(memberPath(request.resource.data.householdId, uid));
    }

    match /invites/{code} {
      // Redeeming requires knowing the exact (random) code; invites cannot be listed
      // except by members of the issuing household.
      allow get: if signedIn();
      allow list: if isMember(resource.data.householdId);

      allow create: if isMember(request.resource.data.householdId)
        && request.resource.data.keys().hasOnly(
          ['householdId', 'createdBy', 'createdByName', 'createdAt', 'expiresAt', 'usedBy', 'usedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && request.resource.data.usedBy == null
        && request.resource.data.usedAt == null
        && code.matches('^[A-Z2-9]{5}(-[A-Z2-9]{5}){3}$');

      // Redemption: only flips usedBy/usedAt, once, before expiry, together with
      // creating the redeemer's member document.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(memberPath(resource.data.householdId, request.auth.uid));

      allow delete: if isMember(resource.data.householdId);
    }

    match /households/{hid} {
      allow read: if isMember(hid);

      // Founding: the creator must create their own owner membership in the same batch.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && str(request.resource.data.name, 1, 80)
        && request.resource.data.householdSize is int
        && request.resource.data.householdSize >= 1
        && request.resource.data.householdSize <= 30
        && existsAfter(memberPath(hid, request.auth.uid));

      allow update: if isMember(hid)
        && unchanged(['ownerUid', 'createdAt'])
        && str(request.resource.data.name, 1, 80)
        && request.resource.data.householdSize is int
        && request.resource.data.householdSize >= 1
        && request.resource.data.householdSize <= 30;

      allow delete: if false;

      function inviteRedeemable(code) {
        let before = get(invitePath(code)).data;
        let after = getAfter(invitePath(code)).data;
        return before.householdId == hid
          && before.usedBy == null
          && before.expiresAt > request.time
          && after.usedBy == request.auth.uid;
      }

      match /members/{uid} {
        allow read: if isMember(hid);
        // A user may always check their own membership (absent doc => not a member).
        allow get: if signedIn() && request.auth.uid == uid;

        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(
            ['uid', 'displayName', 'email', 'photoURL', 'role', 'joinedAt', 'inviteCode'])
          && request.resource.data.joinedAt == request.time
          && (
            // Founder of a brand-new household.
            (request.resource.data.role == 'owner'
              && !exists(householdPath(hid))
              && getAfter(householdPath(hid)).data.ownerUid == uid)
            ||
            // Redeeming a valid invite for this household.
            (request.resource.data.role == 'member'
              && request.resource.data.inviteCode is string
              && inviteRedeemable(request.resource.data.inviteCode))
          );

        // Members may refresh their own profile fields only.
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'email', 'photoURL']);

        // A non-owner may leave.
        allow delete: if signedIn() && request.auth.uid == uid && resource.data.role != 'owner';
      }

      match /inventory/{itemId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && str(request.resource.data.name, 1, 120)
          && request.resource.data.quantity is number
          && request.resource.data.quantity >= 0;
      }

      match /tasks/{taskId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && str(request.resource.data.title, 1, 160)
          && request.resource.data.status in ['todo', 'in_progress', 'complete'];

        match /comments/{commentId} {
          allow read: if isMember(hid);
          allow create: if isMember(hid)
            && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && str(request.resource.data.text, 1, 1000);
          // Discussion history is preserved.
          allow update, delete: if false;
        }
      }

      match /purchases/{purchaseId} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && str(request.resource.data.name, 1, 120)
          && request.resource.data.status in ['proposed', 'approved', 'acquired'];

        match /comments/{commentId} {
          allow read: if isMember(hid);
          allow create: if isMember(hid)
            && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && str(request.resource.data.text, 1, 1000);
          allow update, delete: if false;
        }
      }

      // Household notes. Any member may read, edit, delete and link tasks;
      // authorship and creation time are fixed at creation.
      match /notes/{noteId} {
        function validNote(d) {
          return d.keys().hasOnly(
              ['content', 'createdBy', 'createdByName', 'createdAt', 'updatedAt', 'linkedTaskIds'])
            && str(d.content, 1, 5000)
            && d.createdByName is string
            && d.createdByName.size() <= 120
            && d.linkedTaskIds is list
            && d.linkedTaskIds.size() <= 200;
        }

        allow read, delete: if isMember(hid);

        allow create: if isMember(hid)
          && validNote(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.linkedTaskIds.size() == 0;

        allow update: if isMember(hid)
          && validNote(request.resource.data)
          && unchanged(['createdBy', 'createdByName', 'createdAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
            || request.resource.data.updatedAt == request.time);
      }
    }
  }
}
