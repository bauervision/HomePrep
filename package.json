{
  "name": "homeprep",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:wilderness": "node scripts/generate-wilderness-assets.mjs",
    "assets:icons": "node scripts/generate-brand-icons.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-homeprep \"vitest run --config vitest.rules.config.mts\"",
    "release:status": "node scripts/release.mjs status",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:verify": "node scripts/release.mjs verify",
    "release:tag": "node scripts/release.mjs tag"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.10.0"
}
